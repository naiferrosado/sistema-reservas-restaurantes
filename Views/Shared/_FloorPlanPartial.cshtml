@model SistemaReservas.ViewModels.DashboardViewModel

<div style="margin-bottom:16px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
    <div>
        <div style="font-size:14px; color:var(--text-secondary);">
            Gestiona la distribución de mesas o haz clic sobre una para cambiar su estado operativo en tiempo real.
        </div>
    </div>
    <div style="display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
        <div style="display:flex; gap:16px;">
            <span style="display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-secondary);">
                <span style="width:10px; height:10px; border-radius:50%; background:var(--status-available-text); display:inline-block;"></span>
                Disponible
            </span>
            <span style="display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-secondary);">
                <span style="width:10px; height:10px; border-radius:50%; background:var(--status-reserved-text); display:inline-block;"></span>
                Reservada
            </span>
            <span style="display:flex; align-items:center; gap:6px; font-size:12.5px; color:var(--text-secondary);">
                <span style="width:10px; height:10px; border-radius:50%; background:var(--status-occupied-text); display:inline-block;"></span>
                Ocupada
            </span>
        </div>
        <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-table-create">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            Nueva Mesa
        </button>
    </div>
</div>

@if (!Model.TablesByZone.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
            </svg>
        </div>
        <p class="empty-state-title">Sin mesas configuradas</p>
        <p class="empty-state-description">Este restaurante no tiene mesas registradas en el sistema. Agrega una nueva mesa para comenzar.</p>
        <div style="margin-top:16px;">
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-table-create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Agregar Primera Mesa
            </button>
        </div>
    </div>
}
else
{
    <div class="floor-plan-zones">
        @foreach (var zone in Model.TablesByZone)
        {
            var availableCount = zone.Value.Count(t => t.Status == "Disponible");
            var reservedCount = zone.Value.Count(t => t.Status == "Reservada");
            var occupiedCount = zone.Value.Count(t => t.Status == "Ocupada");

            <div class="floor-plan-zone">
                <div class="floor-plan-zone-header">
                    <span class="floor-plan-zone-title">@zone.Key</span>
                    <span class="floor-plan-zone-meta">
                        @availableCount disponibles &bull; @reservedCount reservadas &bull; @occupiedCount ocupadas
                    </span>
                </div>
                <div class="floor-plan-tables-grid">
                    @foreach (var table in zone.Value)
                    {
                        var statusClass = table.Status switch
                        {
                            "Disponible" => "table-card--available",
                            "Reservada"  => "table-card--reserved",
                            "Ocupada"    => "table-card--occupied",
                            _            => ""
                        };
                        <div class="table-card @statusClass"
                             data-table-id="@table.Id"
                             data-status="@table.Status"
                             title="Clic en la mesa para cambiar estado &bull; Mesa @table.TableNumber (@table.Location)">
                            <div class="table-card-top">
                                <span style="font-size:10.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.04em;">Mesa</span>
                                <div class="table-card-actions">
                                    <button type="button" class="table-action-btn btn-table-edit"
                                            data-modal-open="modal-table-edit"
                                            data-table-id="@table.Id"
                                            data-table-number="@table.TableNumber"
                                            data-table-capacity="@table.Capacity"
                                            data-table-location="@table.Location"
                                            data-table-status="@table.Status"
                                            title="Editar mesa">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </button>
                                    <button type="button" class="table-action-btn table-action-btn--delete btn-table-delete"
                                            data-modal-open="modal-table-delete"
                                            data-table-id="@table.Id"
                                            data-table-number="@table.TableNumber"
                                            title="Eliminar mesa">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="table-card-number">@table.TableNumber</div>
                            <div class="table-card-capacity">@table.Capacity personas</div>
                            <div class="table-card-status">
                                <span class="table-status-indicator"></span>
                                <span>@table.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Resumen de ocupacion -->
    <div style="margin-top:20px; display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
        @{
            var allTables = Model.TablesByZone.Values.SelectMany(t => t).ToList();
            var totalCount = allTables.Count;
            var availableAll = allTables.Count(t => t.Status == "Disponible");
            var reservedAll = allTables.Count(t => t.Status == "Reservada");
            var occupiedAll = allTables.Count(t => t.Status == "Ocupada");
        }
        <div class="kpi-card" style="text-align:center;">
            <div class="kpi-label">Disponibles</div>
            <div class="kpi-value success">@availableAll</div>
            <div class="kpi-meta">de @totalCount mesas totales</div>
        </div>
        <div class="kpi-card" style="text-align:center;">
            <div class="kpi-label">Reservadas</div>
            <div class="kpi-value" style="color:var(--status-reserved-text);">@reservedAll</div>
            <div class="kpi-meta">con reserva asignada</div>
        </div>
        <div class="kpi-card" style="text-align:center;">
            <div class="kpi-label">Ocupadas</div>
            <div class="kpi-value accent">@occupiedAll</div>
            <div class="kpi-meta">en uso actualmente</div>
        </div>
    </div>
}
