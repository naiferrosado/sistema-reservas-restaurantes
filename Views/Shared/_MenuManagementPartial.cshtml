@model SistemaReservas.ViewModels.DashboardViewModel

<div class="card">
    <div class="card-header" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
        <div>
            <div class="card-title">Carta del Restaurante</div>
            <div class="card-subtitle">@Model.MenuItems.Count platillos registrados &mdash; @Model.MenuByCategory.Count categorías</div>
        </div>
        <div>
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-menu-create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Nuevo Platillo
            </button>
        </div>
    </div>

    @if (!Model.MenuByCategory.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                </svg>
            </div>
            <p class="empty-state-title">Carta vacía</p>
            <p class="empty-state-description">No hay platillos registrados para este restaurante. Puedes comenzar agregando el primer ítem a la carta.</p>
            <div style="margin-top:16px;">
                <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-menu-create">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Agregar Primer Platillo
                </button>
            </div>
        </div>
    }
    else
    {
        @foreach (var categoryGroup in Model.MenuByCategory)
        {
            <div style="border-bottom:1px solid var(--border-subtle);">
                <div style="padding:10px 20px; background:var(--bg-surface);">
                    <span style="font-size:11.5px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em;">@categoryGroup.Key</span>
                </div>
                <div class="table-wrapper" style="border:none; border-radius:0;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Platillo</th>
                                <th>Descripción</th>
                                <th>Precio</th>
                                <th>Etiquetas</th>
                                <th>Disponible</th>
                                <th style="text-align:right;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in categoryGroup.Value)
                            {
                                <tr>
                                    <td>
                                        <div style="display:flex; align-items:center; gap:10px;">
                                            <img src="@item.ImageUrl" alt="@item.Name"
                                                 style="width:40px; height:40px; border-radius:6px; object-fit:cover; background:var(--bg-surface);"
                                                 onerror="this.src='https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=80&q=60'" />
                                            <span style="font-weight:600; font-size:13.5px; color:var(--text-primary);">@item.Name</span>
                                        </div>
                                    </td>
                                    <td style="max-width:260px;">
                                        <span style="font-size:13px; color:var(--text-secondary); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@item.Description</span>
                                    </td>
                                    <td style="white-space:nowrap; font-weight:700; color:var(--brand-accent); font-size:14px;">
                                        @($"RD$ {item.Price:N2}")
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Tags))
                                        {
                                            <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                                @foreach (var tag in item.Tags.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)))
                                                {
                                                    <span class="menu-tag">@tag</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span style="color:var(--text-muted); font-size:13px;">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsAvailable)
                                        {
                                            <span class="badge badge--aprobada">
                                                <span class="status-dot"></span>
                                                Disponible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge--rechazada">
                                                <span class="status-dot"></span>
                                                No disponible
                                            </span>
                                        }
                                    </td>
                                    <td style="text-align:right; white-space:nowrap;">
                                        <div style="display:inline-flex; gap:6px;">
                                            <button type="button" class="btn btn-secondary btn-xs btn-menu-edit"
                                                    data-modal-open="modal-menu-edit"
                                                    data-menu-id="@item.Id"
                                                    data-menu-name="@item.Name"
                                                    data-menu-desc="@item.Description"
                                                    data-menu-price="@item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-menu-cat="@item.Category"
                                                    data-menu-img="@item.ImageUrl"
                                                    data-menu-tags="@item.Tags"
                                                    data-menu-available="@(item.IsAvailable ? "true" : "false")"
                                                    title="Editar platillo">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                Editar
                                            </button>
                                            <button type="button" class="btn btn-danger-outline btn-xs btn-menu-delete"
                                                    data-modal-open="modal-menu-delete"
                                                    data-menu-id="@item.Id"
                                                    data-menu-name="@item.Name"
                                                    title="Eliminar platillo">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                                Eliminar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div style="padding:12px 20px; background:var(--bg-surface); font-size:12.5px; color:var(--text-muted); display:flex; justify-content:space-between; align-items:center;">
            <span>Puedes crear, editar y organizar platillos directamente en este panel corporativo.</span>
            <span>API REST disponible en <a href="/swagger" target="_blank" style="color:var(--brand-primary); font-weight:600;">/swagger</a></span>
        </div>
    }
</div>
