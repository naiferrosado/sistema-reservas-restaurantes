@model SistemaReservas.ViewModels.DashboardViewModel

@if (!Model.Notifications.Any())
{
    <div class="empty-state">
        <div class="empty-state-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
            </svg>
        </div>
        <p class="empty-state-title">Bandeja vacia</p>
        <p class="empty-state-description">No hay correos enviados registrados para este restaurante.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Correos Enviados</div>
                <div class="card-subtitle">@Model.Notifications.Count registros en la bandeja de auditoria</div>
            </div>
        </div>
        <div class="inbox-list">
            @foreach (var notification in Model.Notifications)
            {
                var isSimulated = notification.Status.Contains("Simulac") || notification.Status.Contains("Simulado");
                var statusColor = notification.Status.StartsWith("Enviado vía SMTP") ? "var(--status-available-text)"
                    : isSimulated ? "var(--status-pending-text)"
                    : "var(--status-occupied-text)";

                <div class="inbox-item"
                     data-modal-open="modal-email-preview"
                     data-email-body="@Uri.EscapeDataString(notification.BodyHtml)">
                    <div class="inbox-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </div>
                    <div class="inbox-content">
                        <div class="inbox-subject">@notification.Subject</div>
                        <div class="inbox-recipient">Para: @notification.RecipientName &lt;@notification.RecipientEmail&gt;</div>
                    </div>
                    <div class="inbox-meta">
                        <span style="font-size:11.5px; font-weight:600; color:@statusColor;">@notification.Status</span>
                        <span class="inbox-time">@notification.SentAt.ToString("dd/MM/yy HH:mm")</span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div style="margin-top:12px; font-size:12.5px; color:var(--text-muted); display:flex; align-items:center; gap:8px;">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        Haz clic en cualquier correo para ver su contenido HTML completo.
    </div>
}
