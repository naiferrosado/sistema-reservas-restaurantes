@model SistemaReservas.ViewModels.DashboardViewModel
@{
    var currentUserIdStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
}

<!-- SECCIÓN DE GESTIÓN DE USUARIOS -->
<div class="card" style="margin-bottom: 24px; border: 1px solid var(--border-subtle); box-shadow: var(--shadow-sm); border-radius: 10px;">
    
    <!-- ENCABEZADO DE LA SECCIÓN -->
    <div style="padding: 22px 24px; border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                <div style="width: 32px; height: 32px; border-radius: 6px; background: #F1F5F9; color: var(--brand-primary); display: flex; align-items: center; justify-content: center;">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <h2 style="font-size: 18px; font-weight: 700; color: var(--text-primary); margin: 0;">Gestión de Usuarios</h2>
                <span style="font-size: 12px; font-weight: 700; background: #F1F5F9; color: var(--brand-primary); padding: 2px 8px; border-radius: 99px;">
                    @Model.Users.Count total
                </span>
            </div>
            <p style="font-size: 13px; color: var(--text-secondary); margin: 0;">
                Administra los usuarios autorizados, asigna roles operativos y gestiona credenciales de acceso al panel administrativo.
            </p>
        </div>

        <button type="button" class="btn btn-primary" onclick="openCreateUserModal()" style="display: inline-flex; align-items: center; gap: 8px;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            Agregar Usuario
        </button>
    </div>

    <!-- FILTROS Y BÚSQUEDA RÁPIDA -->
    <div style="padding: 14px 24px; background: var(--bg-surface); border-bottom: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; align-items: center; gap: 10px; flex: 1; max-width: 420px;">
            <div style="position: relative; width: 100%;">
                <span style="position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex;">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </span>
                <input type="text" id="user-search-input" class="form-control form-control-sm"
                       placeholder="Buscar por nombre o correo..."
                       style="padding-left: 32px; font-size: 13px;" onkeyup="filterUsersTable()" />
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 10px;">
            <select id="user-role-filter" class="form-control form-control-sm form-select" style="font-size: 13px; width: 190px;" onchange="filterUsersTable()">
                <option value="">Todos los roles</option>
                <option value="Administrador">Administrador</option>
                <option value="Gerente / Encargado">Gerente / Encargado</option>
                <option value="Anfitrión / Recepcionista">Anfitrión / Recepcionista</option>
                <option value="Mesero / Personal de Sala">Mesero / Personal de Sala</option>
            </select>

            <select id="user-status-filter" class="form-control form-control-sm form-select" style="font-size: 13px; width: 140px;" onchange="filterUsersTable()">
                <option value="">Todos los estados</option>
                <option value="Activo">Activos</option>
                <option value="Inactivo">Inactivos</option>
            </select>
        </div>
    </div>

    <!-- TABLA DE USUARIOS -->
    <div style="overflow-x: auto;">
        <table class="table" id="users-table" style="width: 100%; border-collapse: collapse; font-size: 13.5px;">
            <thead>
                <tr style="background: #FAFAFA; border-bottom: 1px solid var(--border-subtle); color: var(--text-secondary); text-align: left;">
                    <th style="padding: 12px 24px; font-weight: 600;">Usuario</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Rol Operativo</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Estado</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Fecha Registro</th>
                    <th style="padding: 12px 24px; font-weight: 600; text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Users.Any())
                {
                    <tr>
                        <td colspan="5" style="padding: 36px; text-align: center; color: var(--text-muted);">
                            No hay usuarios registrados en el sistema.
                        </td>
                    </tr>
                }
                @foreach (var user in Model.Users)
                {
                    var isCurrentUser = user.Id.ToString() == currentUserIdStr;
                    var initials = !string.IsNullOrWhiteSpace(user.FullName)
                        ? string.Join("", user.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper()
                        : "US";

                    var roleBadgeBg = user.Role switch
                    {
                        "Administrador" => "#0F172A",
                        "Gerente / Encargado" => "#1E3A8A",
                        "Anfitrión / Recepcionista" => "#0369A1",
                        "Mesero / Personal de Sala" => "#047857",
                        _ => "#334155"
                    };

                    <tr class="user-row" data-name="@user.FullName.ToLower()" data-email="@user.Email.ToLower()" data-role="@user.Role" data-status="@(user.IsActive ? "Activo" : "Inactivo")"
                        style="border-bottom: 1px solid var(--border-subtle); transition: background 0.15s ease;">
                        
                        <!-- Columna Usuario -->
                        <td style="padding: 14px 24px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 36px; height: 36px; border-radius: 50%; background: #F1F5F9; color: var(--brand-primary); font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--border-subtle);">
                                    @initials
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 6px;">
                                        @user.FullName
                                        @if (isCurrentUser)
                                        {
                                            <span style="font-size: 10.5px; background: #E0E7FF; color: #3730A3; font-weight: 700; padding: 1px 6px; border-radius: 4px;">Tú</span>
                                        }
                                    </div>
                                    <div style="font-size: 12.5px; color: var(--text-secondary); display: flex; align-items: center; gap: 4px;">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                                        @user.Email
                                    </div>
                                </div>
                            </div>
                        </td>

                        <!-- Columna Rol -->
                        <td style="padding: 14px 18px;">
                            <span style="display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 99px; font-size: 12px; font-weight: 600; background: @roleBadgeBg; color: #FFFFFF;">
                                @if (user.Role == "Administrador")
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                }
                                else if (user.Role.Contains("Gerente"))
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                                }
                                else if (user.Role.Contains("Anfitrión") || user.Role.Contains("Recepcionista"))
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                                }
                                else
                                {
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg>
                                }
                                @user.Role
                            </span>
                        </td>

                        <!-- Columna Estado -->
                        <td style="padding: 14px 18px;">
                            @if (user.IsActive)
                            {
                                <span style="display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 99px; font-size: 12px; font-weight: 600; background: var(--status-available-bg); border: 1px solid var(--status-available-border); color: var(--status-available-text);">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #059669;"></span>
                                    Activo
                                </span>
                            }
                            else if (user.FailedLoginAttempts >= 5)
                            {
                                <span style="display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 99px; font-size: 12px; font-weight: 600; background: #FEF2F2; border: 1px solid #FECACA; color: #DC2626;" title="Desactivado automáticamente tras @user.FailedLoginAttempts intentos fallidos">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    Bloqueado (Intentos)
                                </span>
                            }
                            else
                            {
                                <span style="display: inline-flex; align-items: center; gap: 5px; padding: 3px 9px; border-radius: 99px; font-size: 12px; font-weight: 600; background: #F1F5F9; border: 1px solid #CBD5E1; color: #64748B;">
                                    <span style="width: 6px; height: 6px; border-radius: 50%; background: #94A3B8;"></span>
                                    Inactivo
                                </span>
                            }
                        </td>

                        <!-- Columna Fecha -->
                        <td style="padding: 14px 18px; color: var(--text-secondary); font-size: 12.5px;">
                            @user.CreatedAt.ToString("dd/MM/yyyy")
                        </td>

                        <!-- Columna Acciones -->
                        <td style="padding: 14px 24px; text-align: right;">
                            <div style="display: inline-flex; align-items: center; gap: 6px;">
                                
                                <!-- Botón Editar -->
                                <button type="button" class="btn btn-secondary btn-xs"
                                        onclick="openEditUserModal(@user.Id, '@Html.Raw(user.FullName.Replace("'", "\\'"))', '@user.Email', '@user.Role', @(user.IsActive ? "true" : "false"), @(isCurrentUser ? "true" : "false"))"
                                        title="Editar usuario">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                                    Editar
                                </button>

                                <!-- Botón Activar / Desactivar -->
                                @if (!isCurrentUser)
                                {
                                    <form asp-controller="Dashboard" asp-action="ToggleUserStatus" method="post" style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
                                        <button type="submit" class="btn @(user.IsActive ? "btn-secondary" : "btn-success-outline") btn-xs"
                                                title="@(user.IsActive ? "Desactivar acceso" : (user.FailedLoginAttempts >= 5 ? "Desbloquear y activar usuario" : "Activar usuario"))"
                                                style="@(user.IsActive ? "color: #DC2626;" : "")">
                                            @if (user.IsActive)
                                            {
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                                                <span>Desactivar</span>
                                            }
                                            else if (user.FailedLoginAttempts >= 5)
                                            {
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                                <span>Desbloquear</span>
                                            }
                                            else
                                            {
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                                <span>Activar</span>
                                            }
                                        </button>
                                    </form>
                                }

                                <!-- Botón Restablecer Clave -->
                                <button type="button" class="btn btn-secondary btn-xs"
                                        onclick="openResetPasswordUserModal(@user.Id, '@Html.Raw(user.FullName.Replace("'", "\\'"))', '@user.Email')"
                                        title="Restablecer clave de acceso">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                    Clave
                                </button>

                                <!-- Botón Eliminar (no disponible para uno mismo) -->
                                @if (!isCurrentUser)
                                {
                                    <form asp-controller="Dashboard" asp-action="DeleteUser" method="post" style="display: inline;"
                                          onsubmit="return confirm('¿Estás seguro de que deseas eliminar permanentemente a este usuario?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
                                        <button type="submit" class="btn btn-secondary btn-xs" style="color: #DC2626;" title="Eliminar usuario">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- ===================================================================== -->
<!-- MODALES DE GESTIÓN DE USUARIOS                                        -->
<!-- ===================================================================== -->

<!-- MODAL: AGREGAR USUARIO -->
<div class="modal-overlay" id="modal-user-create" style="display: none;">
    <div class="modal modal-md" style="max-width: 520px;">
        <div class="modal-header">
            <span class="modal-title" style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--brand-primary);"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
                Agregar Nuevo Usuario
            </span>
            <button type="button" class="modal-close" onclick="closeCreateUserModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="CreateUser" method="post" id="form-create-user">
            @Html.AntiForgeryToken()
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />

            <div class="modal-body" style="padding: 22px 26px;">
                
                <!-- Nombre completo -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label required">Nombre completo</label>
                    <input type="text" name="fullName" class="form-control" placeholder="Ej: Roberto Gómez" required />
                </div>

                <!-- Correo electrónico -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label required">Correo electrónico</label>
                    <input type="email" name="email" class="form-control" placeholder="usuario@restaurante.com" required />
                </div>

                <!-- Contraseña temporal -->
                <div class="form-group" style="margin-bottom: 16px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label required" style="margin: 0;">Contraseña temporal</label>
                        <button type="button" onclick="generateRandomPassword('create-user-password')" 
                                style="background: none; border: none; color: var(--brand-primary); font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px; padding: 0;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                            Generar aleatoria
                        </button>
                    </div>
                    <div style="position: relative;">
                        <input type="password" name="temporaryPassword" id="create-user-password" class="form-control"
                               placeholder="Mínimo 6 caracteres" style="padding-right: 40px;" required />
                        <button type="button" onclick="togglePasswordVisibility('create-user-password', 'eye-create-user')"
                                style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 4px; display: flex;"
                                title="Mostrar u ocultar contraseña">
                            <svg id="eye-create-user" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                    <span class="form-help" style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px; display: block;">
                        El usuario podrá utilizar esta contraseña para iniciar sesión inmediatamente.
                    </span>
                </div>

                <!-- Rol en el sistema -->
                <div class="form-group" style="margin-bottom: 18px;">
                    <label class="form-label required">Rol en el sistema</label>
                    <select name="role" class="form-control form-select" required>
                        <option value="Administrador">Administrador (Acceso total al sistema y usuarios)</option>
                        <option value="Gerente / Encargado">Gerente / Encargado (Gestión de reservas, mesas, menú y restaurantes)</option>
                        <option value="Anfitrión / Recepcionista" selected>Anfitrión / Recepcionista (Gestión de reservas, mesas y correos)</option>
                        <option value="Mesero / Personal de Sala">Mesero / Personal de Sala (Control de servicio y mesas en sala)</option>
                    </select>
                </div>

                <!-- Estado inicial -->
                <div class="form-group" style="margin-bottom: 0;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--text-primary); user-select: none;">
                        <input type="checkbox" name="isActive" value="true" checked style="width: 16px; height: 16px; accent-color: var(--brand-primary); cursor: pointer;" />
                        <span>Usuario activo inmediatamente en el sistema</span>
                    </label>
                </div>

            </div>

            <div class="modal-footer" style="gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeCreateUserModal()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear Usuario</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDITAR USUARIO -->
<div class="modal-overlay" id="modal-user-edit" style="display: none;">
    <div class="modal modal-md" style="max-width: 520px;">
        <div class="modal-header">
            <span class="modal-title" style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--brand-primary);"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                Editar Usuario
            </span>
            <button type="button" class="modal-close" onclick="closeEditUserModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="UpdateUser" method="post" id="form-edit-user">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-user-id" value="" />
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />

            <div class="modal-body" style="padding: 22px 26px;">
                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label required">Nombre completo</label>
                    <input type="text" name="fullName" id="edit-user-fullname" class="form-control" required />
                </div>

                <div class="form-group" style="margin-bottom: 16px;">
                    <label class="form-label required">Correo electrónico</label>
                    <input type="email" name="email" id="edit-user-email" class="form-control" required />
                </div>

                <div class="form-group" style="margin-bottom: 18px;">
                    <label class="form-label required">Rol en el sistema</label>
                    <select name="role" id="edit-user-role" class="form-control form-select" required>
                        <option value="Administrador">Administrador</option>
                        <option value="Gerente / Encargado">Gerente / Encargado</option>
                        <option value="Anfitrión / Recepcionista">Anfitrión / Recepcionista</option>
                        <option value="Mesero / Personal de Sala">Mesero / Personal de Sala</option>
                    </select>
                </div>

                <div class="form-group" style="margin-bottom: 0;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13.5px; font-weight: 600; color: var(--text-primary); user-select: none;">
                        <input type="checkbox" name="isActive" id="edit-user-isactive" value="true" style="width: 16px; height: 16px; accent-color: var(--brand-primary); cursor: pointer;" />
                        <span>Cuenta activa y habilitada para iniciar sesión</span>
                    </label>
                </div>
            </div>

            <div class="modal-footer" style="gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeEditUserModal()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: RESTABLECER CONTRASEÑA DE USUARIO -->
<div class="modal-overlay" id="modal-user-reset-pwd" style="display: none;">
    <div class="modal modal-md" style="max-width: 480px;">
        <div class="modal-header">
            <span class="modal-title" style="display: flex; align-items: center; gap: 8px;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--brand-primary);"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                Restablecer Clave de Usuario
            </span>
            <button type="button" class="modal-close" onclick="closeResetPasswordUserModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="ResetUserPassword" method="post" id="form-reset-pwd">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="reset-pwd-user-id" value="" />
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />

            <div class="modal-body" style="padding: 22px 26px;">
                
                <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 12px 16px; margin-bottom: 20px;">
                    <div style="font-size: 13.5px; font-weight: 700; color: var(--text-primary);" id="reset-pwd-user-name">Usuario</div>
                    <div style="font-size: 12.5px; color: var(--text-secondary);" id="reset-pwd-user-email">correo@ejemplo.com</div>
                </div>

                <!-- Asignar nueva clave directamente -->
                <div class="form-group" style="margin-bottom: 18px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                        <label class="form-label" style="margin: 0;">Asignar nueva contraseña manual</label>
                        <button type="button" onclick="generateRandomPassword('reset-manual-password')" 
                                style="background: none; border: none; color: var(--brand-primary); font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 4px; padding: 0;">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                            Generar aleatoria
                        </button>
                    </div>
                    <div style="position: relative;">
                        <input type="password" name="newPassword" id="reset-manual-password" class="form-control"
                               placeholder="Dejar vacío si solo enviarás correo de recuperación" style="padding-right: 40px;" />
                        <button type="button" onclick="togglePasswordVisibility('reset-manual-password', 'eye-reset-pwd')"
                                style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 4px; display: flex;"
                                title="Mostrar u ocultar contraseña">
                            <svg id="eye-reset-pwd" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                        </button>
                    </div>
                </div>

                <!-- Enviar correo de recuperación -->
                <div class="form-group" style="margin-bottom: 0;">
                    <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 13.5px; color: var(--text-primary); user-select: none;">
                        <input type="checkbox" name="sendEmail" value="true" checked style="width: 16px; height: 16px; accent-color: var(--brand-primary); cursor: pointer; margin-top: 2px;" />
                        <div>
                            <span style="font-weight: 600;">Enviar correo de restablecimiento al usuario</span>
                            <div style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                                Genera un enlace seguro de recuperación de 30 minutos y lo envía al correo del usuario vía SMTP.
                            </div>
                        </div>
                    </label>
                </div>

            </div>

            <div class="modal-footer" style="gap: 10px;">
                <button type="button" class="btn btn-secondary" onclick="closeResetPasswordUserModal()">Cancelar</button>
                <button type="submit" class="btn btn-primary">Aplicar Cambios</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterUsersTable() {
    var search = document.getElementById('user-search-input').value.toLowerCase().trim();
    var role = document.getElementById('user-role-filter').value;
    var status = document.getElementById('user-status-filter').value;

    var rows = document.querySelectorAll('.user-row');
    rows.forEach(function(row) {
        var name = row.getAttribute('data-name') || '';
        var email = row.getAttribute('data-email') || '';
        var rowRole = row.getAttribute('data-role') || '';
        var rowStatus = row.getAttribute('data-status') || '';

        var matchesSearch = !search || name.includes(search) || email.includes(search);
        var matchesRole = !role || rowRole === role;
        var matchesStatus = !status || rowStatus === status;

        if (matchesSearch && matchesRole && matchesStatus) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });
}

function openCreateUserModal() {
    var modal = document.getElementById('modal-user-create');
    if (modal) {
        modal.style.display = 'flex';
        var pwd = document.getElementById('create-user-password');
        if (pwd && !pwd.value) {
            generateRandomPassword('create-user-password');
        }
    }
}

function closeCreateUserModal() {
    var modal = document.getElementById('modal-user-create');
    if (modal) modal.style.display = 'none';
}

function openEditUserModal(id, fullName, email, role, isActive, isCurrentUser) {
    document.getElementById('edit-user-id').value = id;
    document.getElementById('edit-user-fullname').value = fullName;
    document.getElementById('edit-user-email').value = email;
    document.getElementById('edit-user-role').value = role;
    document.getElementById('edit-user-isactive').checked = isActive;

    var roleSelect = document.getElementById('edit-user-role');
    var activeCheckbox = document.getElementById('edit-user-isactive');

    if (isCurrentUser) {
        roleSelect.disabled = true;
        activeCheckbox.disabled = true;
    } else {
        roleSelect.disabled = false;
        activeCheckbox.disabled = false;
    }

    var modal = document.getElementById('modal-user-edit');
    if (modal) modal.style.display = 'flex';
}

function closeEditUserModal() {
    var modal = document.getElementById('modal-user-edit');
    if (modal) modal.style.display = 'none';
}

function openResetPasswordUserModal(id, fullName, email) {
    document.getElementById('reset-pwd-user-id').value = id;
    document.getElementById('reset-pwd-user-name').textContent = fullName;
    document.getElementById('reset-pwd-user-email').textContent = email;
    document.getElementById('reset-manual-password').value = '';

    var modal = document.getElementById('modal-user-reset-pwd');
    if (modal) modal.style.display = 'flex';
}

function closeResetPasswordUserModal() {
    var modal = document.getElementById('modal-user-reset-pwd');
    if (modal) modal.style.display = 'none';
}

function generateRandomPassword(targetInputId) {
    var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$%&*";
    var password = "";
    for (var i = 0; i < 10; i++) {
        password += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    var input = document.getElementById(targetInputId);
    if (input) {
        input.value = password;
        input.type = 'text'; // Show it temporarily so admin can read/copy it
    }
}
</script>
