<!-- MODAL: ELIMINAR RESTAURANTE -->
<div class="modal-overlay" id="modal-restaurant-delete">
    <div class="modal modal-sm">
        <div class="modal-header">
            <span class="modal-title">Eliminar Restaurante</span>
            <button class="modal-close" data-modal-close="modal-restaurant-delete">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="DeleteRestaurant" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="delete-restaurant-id" value="" />
            <div class="modal-body">
                <p style="font-size:13.5px; color:var(--text-secondary); margin-bottom:12px;">
                    ¿Confirmas que deseas eliminar permanentemente el restaurante <strong class="modal-restaurant-name" style="color:var(--text-primary);"></strong>?
                </p>
                <p style="font-size:12.5px; color:var(--text-muted); margin-bottom:0;">
                    Esta acción eliminará todas las mesas, menú y registros de reservas vinculados a este restaurante.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-restaurant-delete">Cancelar</button>
                <button type="submit" class="btn btn-danger-outline">Eliminar Restaurante</button>
            </div>
        </form>
    </div>
</div>

