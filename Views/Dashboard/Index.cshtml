@model SistemaReservas.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Panel Administrativo";
}

<div class="page-header">
    <div class="page-header-inner">
        <div>
            <h1 class="page-title">Panel Administrativo</h1>
            <p class="page-description">
                @if (Model.SelectedRestaurant != null)
                {
                    <span>@Model.SelectedRestaurant.Name &mdash; Gestion integral de reservas y operaciones</span>
                }
            </p>
        </div>
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            @foreach (var r in Model.Restaurants)
            {
                <a asp-controller="Dashboard" asp-action="Index"
                   asp-route-restaurantId="@r.Id"
                   asp-route-tab="@Model.ActiveTab"
                   style="padding:6px 14px; border-radius:6px; font-size:13px; font-weight:@(r.Id == Model.SelectedRestaurantId ? "700" : "500"); border:1px solid @(r.Id == Model.SelectedRestaurantId ? "var(--brand-primary)" : "var(--border-medium)"); color:@(r.Id == Model.SelectedRestaurantId ? "var(--brand-primary)" : "var(--text-secondary)"); background:@(r.Id == Model.SelectedRestaurantId ? "var(--bg-surface)" : "transparent");">
                    @r.Name
                </a>
            }
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-restaurant-create" style="padding:6px 12px; font-size:12.5px; display:inline-flex; align-items:center; gap:5px;" title="Registrar nuevo restaurante">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Nuevo Restaurante
            </button>
        </div>
    </div>
</div>

<div class="page-container" style="padding-top:0;">

    <!-- KPI CARDS -->
    <partial name="_KpiCardsPartial" model="Model" />

    <!-- SUB-NAVEGACION DE PESTANAS -->
    <div class="tab-nav">
        <a asp-controller="Dashboard" asp-action="Index"
           asp-route-restaurantId="@Model.SelectedRestaurantId"
           asp-route-tab="reservations"
           class="tab-link @(Model.ActiveTab == "reservations" ? "active" : "")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            Gestion de Reservas
        </a>
        <a asp-controller="Dashboard" asp-action="Index"
           asp-route-restaurantId="@Model.SelectedRestaurantId"
           asp-route-tab="floorplan"
           class="tab-link @(Model.ActiveTab == "floorplan" ? "active" : "")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
            Plano de Mesas
        </a>
        <a asp-controller="Dashboard" asp-action="Index"
           asp-route-restaurantId="@Model.SelectedRestaurantId"
           asp-route-tab="inbox"
           class="tab-link @(Model.ActiveTab == "inbox" ? "active" : "")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>
            </svg>
            Bandeja de Correos
            @if (Model.Notifications.Any())
            {
                <span style="background:var(--brand-primary); color:#fff; border-radius:99px; font-size:11px; font-weight:700; padding:1px 7px; min-width:20px; text-align:center;">@Model.Notifications.Count</span>
            }
        </a>
        <a asp-controller="Dashboard" asp-action="Index"
           asp-route-restaurantId="@Model.SelectedRestaurantId"
           asp-route-tab="menu"
           class="tab-link @(Model.ActiveTab == "menu" ? "active" : "")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
            </svg>
            Gestion de Menu
        </a>
        <a asp-controller="Dashboard" asp-action="Index"
           asp-route-restaurantId="@Model.SelectedRestaurantId"
           asp-route-tab="restaurants"
           class="tab-link @(Model.ActiveTab == "restaurants" ? "active" : "")">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
            </svg>
            Gestión de Restaurantes
            <span style="background:var(--bg-surface); color:var(--text-secondary); border:1px solid var(--border-subtle); border-radius:99px; font-size:11px; font-weight:700; padding:1px 7px;">@Model.Restaurants.Count</span>
        </a>
    </div>

    <!-- CONTENIDO POR PESTANA -->
    @if (Model.ActiveTab == "reservations")
    {
        @await Html.PartialAsync("_ReservationsTablePartial", Model)
    }
    else if (Model.ActiveTab == "floorplan")
    {
        @await Html.PartialAsync("_FloorPlanPartial", Model)
    }
    else if (Model.ActiveTab == "inbox")
    {
        @await Html.PartialAsync("_EmailInboxPartial", Model)
    }
    else if (Model.ActiveTab == "menu")
    {
        @await Html.PartialAsync("_MenuManagementPartial", Model)
    }
    else if (Model.ActiveTab == "restaurants")
    {
        @await Html.PartialAsync("_RestaurantsManagementPartial", Model)
    }

</div>

<!-- MODAL: RECHAZAR RESERVA -->
<div class="modal-overlay" id="modal-reject">
    <div class="modal modal-sm">
        <div class="modal-header">
            <span class="modal-title">Rechazar Reserva</span>
            <button class="modal-close" data-modal-close="modal-reject">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="RejectReservation" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" />
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
            <div class="modal-body">
                <p style="font-size:13.5px; color:var(--text-secondary); margin-bottom:16px;">
                    Esta accion notificara al cliente por correo electronico con el motivo proporcionado.
                    La reserva <strong class="modal-reservation-code font-mono"></strong> quedara como <strong>Rechazada</strong>.
                </p>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label required">Motivo del rechazo</label>
                    <textarea name="reason" class="form-control" rows="3"
                              placeholder="Ej: Aforo completo para el horario solicitado." required></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-reject">Cancelar</button>
                <button type="submit" class="btn btn-danger-outline">Confirmar Rechazo</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: PREVISUALIZAR CORREO -->
<div class="modal-overlay" id="modal-email-preview">
    <div class="modal modal-lg">
        <div class="modal-header">
            <span class="modal-title">Vista previa del correo enviado</span>
            <button class="modal-close" data-modal-close="modal-email-preview">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body" style="padding:0;">
            <iframe id="email-preview-frame" style="width:100%; height:520px; border:none;" title="Vista previa del correo HTML"></iframe>
        </div>
        <div class="modal-footer">
            <button class="btn btn-secondary" data-modal-close="modal-email-preview">Cerrar</button>
        </div>
    </div>
</div>

<!-- MODAL: CREAR PLATILLO -->
<div class="modal-overlay" id="modal-menu-create">
    <div class="modal modal-md">
        <div class="modal-header">
            <span class="modal-title">Nuevo Platillo para el Menú</span>
            <button class="modal-close" data-modal-close="modal-menu-create">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="CreateMenuItem" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
            <div class="modal-body">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Nombre del Platillo</label>
                        <input type="text" name="name" class="form-control" placeholder="Ej: Risotto de Setas Silvestres" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Categoría</label>
                        <select name="category" class="form-control form-select" required>
                            <option value="Entrantes">Entrantes</option>
                            <option value="Platos Fuertes" selected>Platos Fuertes</option>
                            <option value="Postres">Postres</option>
                            <option value="Bebidas">Bebidas</option>
                            <option value="Especialidades">Especialidades</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Precio (RD$)</label>
                        <input type="number" name="price" step="0.01" min="0.01" class="form-control" placeholder="850.00" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Etiquetas (separadas por coma)</label>
                        <input type="text" name="tags" class="form-control" placeholder="Especialidad Criolla, Sin Gluten, Recomendado" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">URL de Imagen</label>
                    <input type="url" name="imageUrl" class="form-control" placeholder="https://images.unsplash.com/photo-..." />
                    <span class="form-help">Si se deja vacío, el sistema asignará una imagen gastronómica de alta resolución representativa.</span>
                </div>

                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <textarea name="description" class="form-control" rows="2" placeholder="Detalla los ingredientes y notas culinarias del platillo..."></textarea>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13.5px; font-weight:600; color:var(--text-primary);">
                        <input type="checkbox" name="isAvailable" value="true" checked style="width:16px; height:16px;" />
                        Platillo disponible en carta para clientes
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-menu-create">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Platillo</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDITAR PLATILLO -->
<div class="modal-overlay" id="modal-menu-edit">
    <div class="modal modal-md">
        <div class="modal-header">
            <span class="modal-title">Editar Platillo</span>
            <button class="modal-close" data-modal-close="modal-menu-edit">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="UpdateMenuItem" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-menu-id" value="" />
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
            <div class="modal-body">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Nombre del Platillo</label>
                        <input type="text" name="name" id="edit-menu-name" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Categoría</label>
                        <select name="category" id="edit-menu-category" class="form-control form-select" required>
                            <option value="Entrantes">Entrantes</option>
                            <option value="Platos Fuertes">Platos Fuertes</option>
                            <option value="Postres">Postres</option>
                            <option value="Bebidas">Bebidas</option>
                            <option value="Especialidades">Especialidades</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Precio (RD$)</label>
                        <input type="number" name="price" id="edit-menu-price" step="0.01" min="0.01" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Etiquetas</label>
                        <input type="text" name="tags" id="edit-menu-tags" class="form-control" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">URL de Imagen</label>
                    <input type="url" name="imageUrl" id="edit-menu-image" class="form-control" />
                </div>

                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <textarea name="description" id="edit-menu-desc" class="form-control" rows="2"></textarea>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13.5px; font-weight:600; color:var(--text-primary);">
                        <input type="checkbox" name="isAvailable" id="edit-menu-available" value="true" style="width:16px; height:16px;" />
                        Platillo disponible en carta para clientes
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-menu-edit">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar Platillo</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: ELIMINAR PLATILLO -->
<div class="modal-overlay" id="modal-menu-delete">
    <div class="modal modal-sm">
        <div class="modal-header">
            <span class="modal-title">Eliminar Platillo</span>
            <button class="modal-close" data-modal-close="modal-menu-delete">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="DeleteMenuItem" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="delete-menu-id" value="" />
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
            <div class="modal-body">
                <p style="font-size:13.5px; color:var(--text-secondary); margin-bottom:12px;">
                    ¿Confirmas que deseas eliminar el platillo <strong class="modal-menu-name" style="color:var(--text-primary);"></strong> de la carta?
                </p>
                <p style="font-size:12.5px; color:var(--text-muted); margin-bottom:0;">
                    Esta acción quitará el platillo de manera permanente de la carta del restaurante.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-menu-delete">Cancelar</button>
                <button type="submit" class="btn btn-danger-outline">Eliminar de la Carta</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: CREAR MESA -->
<div class="modal-overlay" id="modal-table-create">
    <div class="modal modal-md">
        <div class="modal-header">
            <span class="modal-title">Nueva Mesa</span>
            <button class="modal-close" data-modal-close="modal-table-create">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="CreateTable" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
            <div class="modal-body">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Número de Mesa</label>
                        <input type="number" name="tableNumber" class="form-control" placeholder="Ej: 14" min="1" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Capacidad (Personas)</label>
                        <input type="number" name="capacity" class="form-control" placeholder="Ej: 4" min="1" max="30" value="4" required />
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Zona / Ubicación</label>
                        <select name="location" class="form-control form-select" required>
                            <option value="Salón Principal" selected>Salón Principal</option>
                            <option value="Terraza">Terraza</option>
                            <option value="Zona VIP">Zona VIP</option>
                            <option value="Jardín">Jardín</option>
                            <option value="Barra Gastronómica">Barra Gastronómica</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Estado Inicial</label>
                        <select name="status" class="form-control form-select" required>
                            <option value="Disponible" selected>Disponible</option>
                            <option value="Reservada">Reservada</option>
                            <option value="Ocupada">Ocupada</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-table-create">Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear Mesa</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: EDITAR MESA -->
