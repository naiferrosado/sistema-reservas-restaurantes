</div>

<!-- MODAL: ELIMINAR MESA -->
<div class="modal-overlay" id="modal-table-delete">
    <div class="modal modal-sm">
        <div class="modal-header">
            <span class="modal-title">Eliminar Mesa</span>
            <button class="modal-close" data-modal-close="modal-table-delete">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="DeleteTable" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="delete-table-id" value="" />
            <input type="hidden" name="restaurantId" value="@Model.SelectedRestaurantId" />
            <div class="modal-body">
                <p style="font-size:13.5px; color:var(--text-secondary); margin-bottom:12px;">
                    ¿Confirmas que deseas eliminar la <strong class="modal-table-name" style="color:var(--text-primary);"></strong> del restaurante?
                </p>
                <p style="font-size:12.5px; color:var(--text-muted); margin-bottom:0;">
                    Las reservas asignadas previamente a esta mesa conservarán su registro y su mesa quedará sin asignar para ser reubicadas.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-table-delete">Cancelar</button>
                <button type="submit" class="btn btn-danger-outline">Eliminar Mesa</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: CREAR RESTAURANTE -->
<div class="modal-overlay" id="modal-restaurant-create">
    <div class="modal modal-md">
        <div class="modal-header">
            <span class="modal-title">Registrar Nuevo Restaurante</span>
            <button class="modal-close" data-modal-close="modal-restaurant-create">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form asp-controller="Dashboard" asp-action="CreateRestaurant" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-body">
                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Nombre del Restaurante</label>
                        <input type="text" name="name" class="form-control" placeholder="Ej: Sabores del Cibao" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Tipo de Cocina</label>
                        <input type="text" name="cuisineType" class="form-control" placeholder="Ej: Criolla Gourmet Contemporánea" required />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Descripción</label>
                    <textarea name="description" class="form-control" rows="2" placeholder="Breve propuesta gastronómica y ambiente del restaurante..."></textarea>
                </div>

                <div class="form-group">
                    <label class="form-label required">Dirección en República Dominicana</label>
                    <input type="text" name="address" class="form-control" placeholder="Ej: Av. Winston Churchill #105, Piantini, Santo Domingo" required />
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Teléfono (+1 809 / 829 / 849)</label>
                        <input type="tel" name="phone" class="form-control" placeholder="+1 (809) 555-0100" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Correo de Contacto</label>
                        <input type="email" name="email" class="form-control" placeholder="contacto@restaurante.com.do" required />
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label required">Hora Apertura</label>
                        <input type="text" name="openingTime" class="form-control" value="12:00" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Hora Cierre</label>
                        <input type="text" name="closingTime" class="form-control" value="23:00" required />
                    </div>
                </div>

                <div class="form-grid-3">
                    <div class="form-group">
                        <label class="form-label required">Aforo / Capacidad</label>
                        <input type="number" name="totalCapacity" class="form-control" value="50" min="1" max="500" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Rango de Precios</label>
                        <select name="priceRange" class="form-control form-select" required>
                            <option value="$$">$$ (RD$ 600 - 1,200)</option>
                            <option value="$$$" selected>$$$ (RD$ 1,200 - 2,500)</option>
                            <option value="$$$$">$$$$ (RD$ 2,500+ Gourmet)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label required">Calificación</label>
                        <input type="number" name="rating" class="form-control" value="4.8" min="1" max="5" step="0.1" required />
                    </div>
                </div>

                <div class="form-group" style="margin-bottom:0;">
                    <label class="form-label">URL de Imagen</label>
                    <input type="url" name="imageUrl" class="form-control" placeholder="https://images.unsplash.com/..." value="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&q=80" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-modal-close="modal-restaurant-create">Cancelar</button>
                <button type="submit" class="btn btn-primary">Crear Restaurante</button>
            </div>
        </form>
    </div>
</div>

