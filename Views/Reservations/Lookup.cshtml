@model SistemaReservas.ViewModels.ReservationLookupViewModel
@{
    ViewData["Title"] = "Consultar Reserva";
}

<div class="page-header">
    <div class="page-header-inner">
        <div>
            <h1 class="page-title">Consultar Reserva</h1>
            <p class="page-description">Ingresa tu codigo de reserva o correo electronico para ver el estado de tu solicitud.</p>
        </div>
    </div>
</div>

<div class="page-container" style="padding-top:0; max-width:680px;">

    <!-- FORMULARIO DE BUSQUEDA -->
    <div class="card" style="margin-bottom:24px;">
        <div class="card-header">
            <div class="card-title">Buscar Reserva</div>
        </div>
        <div class="card-body">
            <form asp-controller="Reservations" asp-action="Lookup" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Codigo de Reserva</label>
                        <input name="SearchCode" value="@Model.SearchCode" class="form-control font-mono"
                               placeholder="RES-1023-4835"
                               style="text-transform:uppercase; letter-spacing:0.05em;" />
                        <div class="form-help">Formato: RES-XXXX-XXXX</div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">O busca por Correo Electronico</label>
                        <input name="SearchEmail" value="@Model.SearchEmail" class="form-control"
                               placeholder="tu@correo.com" type="email" />
                        <div class="form-help">El correo que usaste al reservar</div>
                    </div>
                </div>

                @if (Model.HasSearched && !string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div style="background:var(--status-occupied-bg); border:1px solid var(--status-occupied-border); border-radius:6px; padding:12px 14px; margin-bottom:4px; font-size:13.5px; color:var(--status-occupied-text);">
                        @Model.ErrorMessage
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                        </svg>
                        Buscar Reserva
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- RESULTADOS -->
    @if (Model.HasSearched && Model.Results.Any())
    {
        <div style="margin-bottom:12px; font-size:13.5px; color:var(--text-secondary);">
            Se encontraron <strong>@Model.Results.Count</strong> reserva@(Model.Results.Count != 1 ? "s" : "") con los datos proporcionados.
        </div>

        @foreach (var res in Model.Results)
        {
            var restaurant = res.Restaurant;
            var table = res.Table;

            var statusBadgeClass = res.Status switch
            {
                "Aprobada" or "Confirmada" => "badge--aprobada",
                "Pendiente" => "badge--pendiente",
                "Rechazada" => "badge--rechazada",
                _ => "badge--pendiente"
            };

            <div class="card" style="margin-bottom:16px;">
                <div class="card-header" style="flex-wrap:wrap; gap:8px;">
                    <div>
                        <div class="card-title" style="font-family:var(--font-mono);">@res.ReservationCode</div>
                        <div class="card-subtitle">@res.CustomerName &mdash; @(restaurant?.Name ?? "—")</div>
                    </div>
                    <span class="badge @statusBadgeClass">
                        <span class="status-dot"></span>
                        @res.Status
                    </span>
                </div>
                <div class="card-body">
                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px 24px;">
                        <div>
                            <div style="font-size:11.5px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:3px;">Fecha y Hora</div>
                            <div style="font-size:14px; color:var(--text-primary); font-weight:500;">
                                @res.ReservationDate.ToString("dd/MM/yyyy") a las @res.ReservationTime hrs
                            </div>
                        </div>
                        <div>
                            <div style="font-size:11.5px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:3px;">Comensales</div>
                            <div style="font-size:14px; color:var(--text-primary); font-weight:500;">@res.PartySize @(res.PartySize == 1 ? "persona" : "personas")</div>
                        </div>
                        <div>
                            <div style="font-size:11.5px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:3px;">Restaurante</div>
                            <div style="font-size:14px; color:var(--text-primary); font-weight:500;">@(restaurant?.Name ?? "—")</div>
                        </div>
                        <div>
                            <div style="font-size:11.5px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:3px;">Mesa asignada</div>
                            <div style="font-size:14px; color:var(--text-primary); font-weight:500;">
                                @if (table != null) { <span>Mesa @table.TableNumber (@table.Location)</span> } else { <span>Por asignar</span> }
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(res.SpecialRequests))
                    {
                        <div style="margin-top:14px; padding-top:14px; border-top:1px solid var(--border-subtle);">
                            <div style="font-size:11.5px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:4px;">Peticiones Especiales</div>
                            <div style="font-size:13.5px; color:var(--text-secondary);">@res.SpecialRequests</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(res.AdminNotes) && res.Status == "Rechazada")
                    {
                        <div style="margin-top:14px; padding:12px 14px; background:var(--status-occupied-bg); border:1px solid var(--status-occupied-border); border-radius:6px;">
                            <div style="font-size:12px; font-weight:700; color:var(--status-occupied-text); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px;">Motivo de rechazo</div>
                            <div style="font-size:13.5px; color:var(--status-occupied-text);">@res.AdminNotes</div>
                        </div>
                    }

                    <div style="margin-top:16px; padding-top:12px; border-top:1px solid var(--border-subtle); font-size:12px; color:var(--text-muted);">
                        Solicitud registrada el @res.CreatedAt.ToString("dd/MM/yyyy 'a las' HH:mm")
                    </div>
                </div>
            </div>
        }

        <div style="margin-top:16px; text-align:center;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Explorar Restaurantes</a>
        </div>
    }
    else if (!Model.HasSearched)
    {
        <!-- ESTADO INICIAL -->
        <div class="empty-state">
            <div class="empty-state-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
                </svg>
            </div>
            <p class="empty-state-title">Consulta el estado de tu reserva</p>
            <p class="empty-state-description">Usa el formulario de arriba para buscar tu reserva por codigo o correo electronico.</p>
        </div>
    }

</div>
