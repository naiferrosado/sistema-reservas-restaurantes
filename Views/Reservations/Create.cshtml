@model SistemaReservas.ViewModels.CreateReservationViewModel
@{
    ViewData["Title"] = "Reservar Mesa";
}

<div class="page-header">
    <div class="page-header-inner">
        <div>
            <h1 class="page-title">Nueva Reserva</h1>
            <p class="page-description">
                @if (Model.Restaurant != null)
                {
                    <span>@Model.Restaurant.Name &mdash; @Model.Restaurant.CuisineType</span>
                }
                else
                {
                    <span>Completa el formulario para solicitar tu mesa.</span>
                }
            </p>
        </div>
        <a asp-controller="Home" asp-action="Index"
           asp-route-restaurantId="@Model.RestaurantId"
           class="btn btn-secondary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5"/><path d="m12 19-7-7 7-7"/>
            </svg>
            Volver
        </a>
    </div>
</div>

<div class="page-container" style="padding-top:0; max-width:820px;">

    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Datos de la Reserva</div>
                <div class="card-subtitle">Todos los campos marcados con * son obligatorios.</div>
            </div>
            @if (Model.Restaurants.Any())
            {
                <div style="display:flex; gap:8px; align-items:center;">
                    <span style="font-size:12.5px; color:var(--text-muted); font-weight:500;">Restaurante:</span>
                    @foreach (var r in Model.Restaurants)
                    {
                        <a asp-controller="Reservations" asp-action="Create"
                           asp-route-restaurantId="@r.Id"
                           style="padding:4px 12px; border-radius:99px; font-size:12.5px; font-weight:@(r.Id == Model.RestaurantId ? "700" : "500"); border:1px solid @(r.Id == Model.RestaurantId ? "var(--brand-primary)" : "var(--border-medium)"); color:@(r.Id == Model.RestaurantId ? "var(--brand-primary)" : "var(--text-secondary)"); background:@(r.Id == Model.RestaurantId ? "var(--bg-surface)" : "transparent");">
                            @r.Name
                        </a>
                    }
                </div>
            }
        </div>

        <div class="card-body">
            <form asp-controller="Reservations" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <input type="hidden" asp-for="RestaurantId" />

                <!-- Datos del Cliente -->
                <h3 style="font-size:13px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:16px;">
                    Datos del Cliente
                </h3>

                <div class="form-grid-3">
                    <div class="form-group">
                        <label asp-for="CustomerName" class="form-label required"></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Carlos Rosario Minaya" autocomplete="name" />
                        <span asp-validation-for="CustomerName" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerEmail" class="form-label required"></label>
                        <input asp-for="CustomerEmail" class="form-control" placeholder="carlos@correo.do" type="email" autocomplete="email" />
                        <span asp-validation-for="CustomerEmail" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CustomerPhone" class="form-label required"></label>
                        <input asp-for="CustomerPhone" class="form-control" placeholder="+1 (809) 000-0000" type="tel" autocomplete="tel" />
                        <span asp-validation-for="CustomerPhone" class="field-validation-error"></span>
                    </div>
                </div>

                <div style="height:1px; background:var(--border-subtle); margin:4px 0 20px;"></div>

                <!-- Detalles de la Reserva -->
                <h3 style="font-size:13px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.05em; margin-bottom:16px;">
                    Detalles de la Reserva
                </h3>

                <div class="form-grid-3">
                    <div class="form-group">
                        <label asp-for="ReservationDate" class="form-label required"></label>
                        <input asp-for="ReservationDate" class="form-control" type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@Model.ReservationDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="ReservationDate" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="ReservationTime" class="form-label required"></label>
                        <select asp-for="ReservationTime" class="form-control form-select">
                            @foreach (var slot in Model.TimeSlots)
                            {
                                <option value="@slot">@slot hrs</option>
                            }
                        </select>
                        <span asp-validation-for="ReservationTime" class="field-validation-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PartySize" class="form-label required"></label>
                        <select asp-for="PartySize" class="form-control form-select">
                            @for (int i = 1; i <= 20; i++)
                            {
                                <option value="@i">@i persona@(i > 1 ? "s" : "")</option>
                            }
                        </select>
                        <span asp-validation-for="PartySize" class="field-validation-error"></span>
                    </div>
                </div>

                <!-- Selección de Mesa (Opcional) -->
                <div class="form-group">
                    <label class="form-label">Mesa preferida <span style="color:var(--text-muted); font-weight:400;">(opcional — se asignará automáticamente si no seleccionas)</span></label>
                    <select asp-for="TableId" class="form-control form-select">
                        <option value="">Asignar automáticamente la mejor mesa disponible</option>
                        @if (Model.AvailableTables.Any())
                        {
                            var zones = Model.AvailableTables.GroupBy(t => t.Location);
                            @foreach (var zone in zones)
                            {
                                <optgroup label="@zone.Key">
                                    @foreach (var table in zone)
                                    {
                                        <option value="@table.Id">Mesa @table.TableNumber — @table.Capacity personas — @table.Status</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                </div>

                <!-- Peticiones Especiales -->
                <div class="form-group">
                    <label asp-for="SpecialRequests" class="form-label"></label>
                    <textarea asp-for="SpecialRequests" class="form-control" rows="3"
                              placeholder="Ej: silla alta para bebé, alergias alimentarias, ocasión especial..."></textarea>
                    <span asp-validation-for="SpecialRequests" class="field-validation-error"></span>
                </div>

                <!-- Nota informativa -->
                <div style="background:var(--bg-surface); border:1px solid var(--border-subtle); border-radius:6px; padding:12px 14px; margin-bottom:4px; font-size:13px; color:var(--text-secondary); line-height:1.5;">
                    <strong style="color:var(--text-primary);">Informacion importante:</strong>
                    Tu solicitud quedara en estado <strong>Pendiente</strong> hasta que el equipo del restaurante la revise y apruebe. Recibiras una notificacion por correo electronico con la confirmacion o el motivo de rechazo.
                </div>

                <div class="form-actions">
                    <a asp-controller="Home" asp-action="Index"
                       asp-route-restaurantId="@Model.RestaurantId"
                       class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Solicitar Reserva
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
