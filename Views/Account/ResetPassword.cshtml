@model SistemaReservas.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="page-container" style="max-width: 460px; padding-top: 60px; padding-bottom: 80px;">

    <div class="card" style="box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06); border: 1px solid var(--border-subtle); border-radius: 10px;">
        
        <!-- ENCABEZADO -->
        <div style="padding: 32px 32px 20px; text-align: center; border-bottom: 1px solid var(--border-subtle);">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: #F1F5F9; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; color: var(--brand-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
            </div>
            <h1 style="font-size: 22px; font-weight: 700; color: var(--text-primary); margin: 0 0 6px;">
                Restablecer Contraseña
            </h1>
            <p style="font-size: 13.5px; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                Ingresa y confirma tu nueva clave de acceso para actualizar tu cuenta.
            </p>
        </div>

        <div style="padding: 28px 32px;">

            @if (ViewBag.InvalidToken == true)
            {
                <div style="background: var(--status-occupied-bg); border: 1px solid var(--status-occupied-border); border-radius: 8px; padding: 18px; margin-bottom: 24px; text-align: center;">
                    <div style="width: 36px; height: 36px; border-radius: 50%; background: #FEE2E2; color: #DC2626; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    </div>
                    <p style="font-size: 13.5px; color: var(--status-occupied-text); margin: 0 0 14px; line-height: 1.5;">
                        @(ViewBag.ErrorMessage ?? "El enlace de restablecimiento es inválido o ha expirado.")
                    </p>
                    <a asp-action="ForgotPassword" class="btn btn-secondary btn-sm" style="display: inline-flex;">
                        Solicitar nuevo enlace
                    </a>
                </div>

                <div style="text-align: center;">
                    <a asp-action="Login" style="font-size: 13px; color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                        Volver a Acceso Administrativo
                    </a>
                </div>
            }
            else
            {
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    @if (TempData["UpgradeNotice"] != null)
                    {
                        <div style="background: #FFFBEB; border: 1px solid #FDE68A; border-left: 4px solid #D97706; border-radius: 6px; padding: 12px 14px; margin-bottom: 16px; font-size: 13px; color: #92400E; line-height: 1.45;">
                            @TempData["UpgradeNotice"]
                        </div>
                    }

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
                    {
                        <div style="background: var(--status-occupied-bg); border: 1px solid var(--status-occupied-border); border-radius: 6px; padding: 12px 14px; margin-bottom: 20px; font-size: 13px; color: var(--status-occupied-text);">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div style="background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 6px; padding: 10px 14px; margin-bottom: 18px; font-size: 13px; color: var(--text-secondary); display: flex; align-items: center; gap: 8px;">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" style="color: var(--brand-primary);"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                        <span>Restableciendo contraseña para: <strong>@Model.Email</strong></span>
                    </div>

                    <!-- Nueva Contraseña -->
                    <div class="form-group" style="margin-bottom: 18px;">
                        <label asp-for="NewPassword" class="form-label required"></label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </span>
                            <input asp-for="NewPassword" class="form-control" id="input-new-password"
                                   placeholder="Mínimo 8 caracteres" minlength="8" autocomplete="new-password"
                                   oninput="updatePasswordChecklist(this.value)"
                                   style="padding-left: 38px; padding-right: 38px;" autofocus />
                            <button type="button" onclick="togglePasswordVisibility('input-new-password', 'eye-icon-new')" 
                                    style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 4px; display: flex;"
                                    title="Mostrar u ocultar contraseña">
                                <svg id="eye-icon-new" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="field-validation-error"></span>
                        <div id="pwd-checklist" style="margin-top: 8px; padding: 10px 12px; background: #F8FAFC; border: 1px solid var(--border-subtle); border-radius: 6px; font-size: 12px; color: var(--text-secondary); display: grid; grid-template-columns: 1fr 1fr; gap: 4px 10px;">
                            <div id="req-len">• Mínimo 8 caracteres</div>
                            <div id="req-upper">• Una mayúscula (A-Z)</div>
                            <div id="req-lower">• Una minúscula (a-z)</div>
                            <div id="req-digit">• Un número (0-9)</div>
                            <div id="req-special" style="grid-column: span 2;">• Un carácter especial (!@@#$%&amp;*)</div>
                        </div>
                    </div>

                    <!-- Confirmar Contraseña -->
                    <div class="form-group" style="margin-bottom: 24px;">
                        <label asp-for="ConfirmPassword" class="form-label required"></label>
                        <div style="position: relative;">
                            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); display: flex;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </span>
                            <input asp-for="ConfirmPassword" class="form-control" id="input-confirm-password"
                                   placeholder="Repite la nueva clave" style="padding-left: 38px; padding-right: 38px;" />
                            <button type="button" onclick="togglePasswordVisibility('input-confirm-password', 'eye-icon-confirm')" 
                                    style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 4px; display: flex;"
                                    title="Mostrar u ocultar contraseña">
                                <svg id="eye-icon-confirm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width: 100%; height: 44px; font-size: 14.5px; justify-content: center;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        Guardar Nueva Contraseña
                    </button>
                </form>

                <div style="margin-top: 24px; text-align: center;">
                    <a asp-action="Login" style="font-size: 13px; color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                        Volver a Acceso Administrativo
                    </a>
                </div>
            }

        </div>

    </div>

</div>

<script>
function updatePasswordChecklist(val) {
    var rules = {
        'req-len': val.length >= 8,
        'req-upper': /[A-Z]/.test(val),
        'req-lower': /[a-z]/.test(val),
        'req-digit': /[0-9]/.test(val),
        'req-special': /[^A-Za-z0-9\s]/.test(val)
    };
    Object.keys(rules).forEach(function(id) {
        var el = document.getElementById(id);
        if (!el) return;
        el.style.color = rules[id] ? '#059669' : 'var(--text-secondary)';
        el.style.fontWeight = rules[id] ? '600' : '400';
    });
}

function togglePasswordVisibility(inputId, iconId) {
    var input = document.getElementById(inputId);
    var icon = document.getElementById(iconId);
    if (!input) return;
    if (input.type === 'password') {
        input.type = 'text';
        if (icon) {
            icon.innerHTML = '<path d="m2 2 20 20"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>';
        }
    } else {
        input.type = 'password';
        if (icon) {
            icon.innerHTML = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
        }
    }
}
</script>
