# ==========================================================
# .gitignore para ASP.NET Core & PostgreSQL
# ==========================================================

# 1. Archivos con Credenciales y Datos Sensibles (Passwords, ConnectionStrings, SMTP)
appsettings.json
appsettings.Development.json
appsettings.Production.json
appsettings.*.json

# Mantener en Git las plantillas de ejemplo públicas
!appsettings.example.json
!appsettings.*.example.json

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Claves privadas, certificados SSL y firmas
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem

# 2. Compilación y Binarios de .NET (Build Output)
bin/
obj/
out/
publish/
[Bb]in/
[Oo]bj/

# 3. Archivos de Bases de Datos locales y volcados
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak
*.dump

# 4. Configuración de Entornos de Desarrollo (IDEs)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.vs/
*.user
*.userosscache
*.sln.docstates
*.suo

# 5. Logs y Archivos Temporales
*.log
logs/
_ReSharper*/
[Tt]emp/
[Tt]mp/

# 6. Archivos del Sistema Operativo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
